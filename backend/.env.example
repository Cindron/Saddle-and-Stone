# Saddle & Stone backend
# Copy to backend/.env before starting the backend test service.
# Never commit backend/.env.

PORT=8787
DATA_DIR=/data

# The browser origin allowed to make authenticated owner requests.
# Keep this exact when the owner portal is eventually reverse-proxied.
APP_ORIGIN=https://saddleandstone.cindron.ca

# true behind HTTPS. Set false only for direct localhost HTTP testing.
COOKIE_SECURE=true
SESSION_DAYS=7
TRUST_PROXY=1

# Upload limits
MAX_UPLOAD_MB=12
MAX_IMAGES_PER_ITEM=8

# Optional inquiry email notifications.
# Inquiries are always saved to the database even if email is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INQUIRY_NOTIFY_TO=saddle.and.stone.estate@gmail.com
