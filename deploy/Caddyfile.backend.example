# Saddle & Stone path routing example.
# This preserves the approved public site for every path except the explicitly
# isolated backend paths below.

saddleandstone.cindron.ca {
    @owner path /owner /owner/*
    handle @owner {
        reverse_proxy saddle-stone-backend:8787
    }

    @catalog path /catalog /catalog/*
    handle @catalog {
        reverse_proxy saddle-stone-backend:8787
    }

    @calendar path /calendar /calendar/*
    handle @calendar {
        reverse_proxy saddle-stone-backend:8787
    }

    @api path /api/*
    handle @api {
        reverse_proxy saddle-stone-backend:8787
    }

    @uploads path /uploads/*
    handle @uploads {
        reverse_proxy saddle-stone-backend:8787
    }

    # Existing approved public website remains the default.
    handle {
        reverse_proxy saddle-stone-web:80
    }
}
